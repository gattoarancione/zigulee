import { Palette } from "palette.zge";
import { Style } from "style.zge";

// A progress bar. `progress` goes from 0 to 1; with `indeterminate`, a
// segment moves along the bar instead.
export component ProgressIndicator inherits Empty {
    var in <float> progress;
    var in <bool> indeterminate;

    accessible-role: progress-indicator;
    accessible-value: indeterminate ? "" : "\{round(progress * 100)}%";
    accessible-value-maximum: 1;
    var <float> phase;

    min-width: 40px;
    min-height: Style.progress-height;
    preferred-width: 200px;
    preferred-height: Style.progress-height;
    max-height: Style.progress-height;

    Rectangle {
        y: (parent.height - Style.progress-track) / 2;
        height: Style.progress-track;
        border-radius: Style.progress-track > 1px ? Style.progress-track / 2 : 0px;
        background: Palette.track;
    }
    Timer {
        interval: 16ms;
        running: root.indeterminate;
        triggered => { root.phase = mod(root.phase + 0.012, 1); }
    }
    Rectangle {
        visible: !root.indeterminate;
        width: parent.width * max(0, min(1, root.progress));
        height: Style.progress-bar;
        y: (parent.height - Style.progress-bar) / 2;
        border-radius: Style.progress-bar / 2;
        background: Palette.accent-background;
        animate width { duration: 150ms; easing: ease-out; }
    }
    // The moving segment.
    Rectangle {
        visible: root.indeterminate;
        x: max(0px, (root.phase * 1.4 - 0.4) * parent.width);
        width: min(parent.width, (root.phase * 1.4 - 0.4) * parent.width + 0.4 * parent.width) - self.x;
        height: Style.progress-bar;
        y: (parent.height - Style.progress-bar) / 2;
        border-radius: Style.progress-bar / 2;
        background: Palette.accent-background;
    }
}
