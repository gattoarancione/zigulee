import { Palette } from "palette.zge";
import { Style } from "style.zge";

// The edge a Drawer comes from.
export enum DrawerEdge { left, right, top, bottom }

// A panel that slides in from an edge of the window (`edge`), over the
// window dimmed: `open()` shows it, `dismiss()` slides it out (so do a
// click on the dimmed window, a swipe towards its edge, and Escape). With
// `interactive`, it is also pulled out by a drag from that edge of the
// window (begun within `drag-margin` of it): let go past half way, or
// flicked, it opens, else it slides back. Its content is the elements put
// in it, one above the other. `size` is its width (its height from the top
// or bottom).
export component Drawer inherits PopupWindow {
    var in <DrawerEdge> edge: DrawerEdge.left;
    var in <length> size: 280px;
    var in <bool> interactive: true;
    var in <length> drag-margin: 20px;
    // How far it is in (0: out, 1: in).
    var out <float> position: root.progress;
    // It went (slid out, or Escape).
    callback dismissed();

    public function open() {
        root.closing = false;
        slide-out.stop();
        if !root.is-open { root.show(); }
        slide-in.start();
        keys.focus();
    }
    public function dismiss() {
        if root.is-open && !root.closing {
            root.closing = true;
            slide-in.stop();
            slide-out.start();
        }
    }

    function towards-edge(direction: SwipeDirection) -> bool {
        if root.edge == DrawerEdge.left { return direction == SwipeDirection.left; }
        if root.edge == DrawerEdge.right { return direction == SwipeDirection.right; }
        if root.edge == DrawerEdge.top { return direction == SwipeDirection.up; }
        return direction == SwipeDirection.down;
    }

    var <float> progress: 0;
    var <bool> closing;
    var <bool> horizontal: root.edge == DrawerEdge.left || root.edge == DrawerEdge.right;

    slide-in := PropertyAnimation { target: root.progress; to: 1; duration: 220ms; easing: ease-out; }
    // Slid out: closed.
    slide-out := PropertyAnimation {
        target: root.progress;
        to: 0;
        duration: 220ms;
        easing: ease-out;
        finished => {
            if root.closing {
                root.closing = false;
                root.close();
            }
        }
    }
    // Closed by the window (Escape) or once slid out.
    changed is-open => {
        if !root.is-open {
            root.closing = false;
            slide-in.stop();
            slide-out.stop();
            root.progress = 0;
            root.dismissed();
        }
    }

    // Pulled out of its edge.
    edge-margin: root.interactive ? root.drag-margin : 0px;
    open-swipe: root.edge == DrawerEdge.left ? SwipeDirection.right
        : root.edge == DrawerEdge.right ? SwipeDirection.left
        : root.edge == DrawerEdge.top ? SwipeDirection.down : SwipeDirection.up;
    edge-dragged(distance) => {
        if !root.is-open {
            root.closing = false;
            root.show();
            keys.focus();
        }
        slide-in.stop();
        slide-out.stop();
        root.progress = min(1, distance / max(1px, root.horizontal ? panel.width : panel.height));
    }
    edge-released(distance, speed) => {
        if speed > 300 || (speed > -300 && root.progress > 0.5) {
            root.open();
        } else {
            root.dismiss();
        }
    }

    close-policy: no-auto-close;
    fill-window: true;
    accessible-role: group;

    // The dimmed window: a click there dismisses it.
    Rectangle {
        background: Palette.dark ? #00000099 : #00000059;
        opacity: root.progress;
        TouchArea {
            clicked => { root.dismiss(); }
        }
    }
    panel := Rectangle {
        width: root.horizontal ? min(root.size, parent.width) : parent.width;
        height: root.horizontal ? parent.height : min(root.size, parent.height);
        x: root.edge == DrawerEdge.left ? (root.progress - 1) * self.width
            : root.edge == DrawerEdge.right ? parent.width - root.progress * self.width : 0px;
        y: root.edge == DrawerEdge.top ? (root.progress - 1) * self.height
            : root.edge == DrawerEdge.bottom ? parent.height - root.progress * self.height : 0px;
        background: Palette.alternate-background;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000040;

        // Swiped towards its edge: dismissed.
        SwipeArea {
            swiped(direction) => {
                if root.towards-edge(direction) {
                    root.dismiss();
                }
            }
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                alignment: start;
                @children
            }
        }
        keys := FocusScope {
            width: 0px;
            height: 0px;
        }
    }
}
