// Colors of the fluent style. Set `Palette.dark` to switch to dark mode.

export global Palette {
    var in-out <bool> dark;

    var out <color> background: dark ? #202020 : #f3f3f3;
    var out <color> foreground: dark ? #ffffff : #1b1b1b;
    var out <color> alternate-background: dark ? #2b2b2b : #fbfbfb;
    var out <color> secondary-foreground: dark ? #c5c5c5 : #5d5d5d;
    var out <color> disabled-foreground: dark ? #787878 : #a0a0a0;

    var out <color> control-background: dark ? #2d2d2d : #fdfdfd;
    var out <color> control-hover: dark ? #323232 : #f5f5f5;
    var out <color> control-pressed: dark ? #272727 : #f0f0f0;
    var out <color> control-disabled: dark ? #2a2a2a : #f5f5f5;
    var out <color> border: dark ? #3c3c3c : #e0e0e0;
    // Outlines of unchecked toggles and the empty part of tracks.
    var out <color> strong-border: dark ? #9a9a9a : #8a8a8a;
    var out <color> track: dark ? #9a9a9a : #8a8a8a;

    var out <color> accent-background: dark ? #4cc2ff : #005fb8;
    var out <color> accent-hover: dark ? #48b1e8 : #1a6fc0;
    var out <color> accent-pressed: dark ? #4299c7 : #3381c8;
    var out <color> accent-foreground: dark ? #000000 : #ffffff;

    var out <color> focus-ring: dark ? #ffffff : #1b1b1b;

    // Text fields.
    var out <color> input-background: dark ? #2d2d2d : #fdfdfd;
    var out <color> input-focused-background: dark ? #1f1f1f : #ffffff;
    var out <color> selection-background: dark ? #4cc2ff55 : #005fb84d;
    var out <color> placeholder-foreground: dark ? #a0a0a0 : #8a8a8a;
    var out <color> input-focus-border: dark ? #3c3c3c : #e0e0e0;
    var out <color> slider-thumb: dark ? #2d2d2d : #fdfdfd;

    // Switches: the track when off, the knob off and on.
    var out <color> switch-track: control-background;
    var out <color> switch-track-hover: control-hover;
    var out <color> switch-knob: strong-border;
    var out <color> switch-knob-checked: accent-foreground;
    // Shadows (see Style's): under controls, under knobs.
    var out <color> control-shadow: dark ? #00000040 : #00000026;
    var out <color> knob-shadow: #00000000;

    // Scroll bars and tabs.
    var out <color> scrollbar: dark ? #9a9a9a99 : #8a8a8a99;
    var out <color> scrollbar-hover: dark ? #c5c5c5cc : #5d5d5dcc;
}
