// Rich text: Markdown with styles, lists and links; HTML with a table,
// selectable.
export component Rich inherits Window {
    width: 280px;
    height: 300px;
    background: #ffffff;
    var out <string> opened;
    var out <length> text-height: notes.preferred-height;
    var out <string> picked: prices.selected-text;

    VerticalLayout {
        padding: 10px;
        notes := StyledText {
            text: "# Notes\nSome **bold**, *italic*, ~~old~~ and `code`; see [the docs](https://example.org/docs) for more.\n\n- first\n- second, which is long enough to wrap onto the next line\n  - nested\n1. one\n2. two";
            font-size: 13px;
            link-clicked(url) => { root.opened = url; }
        }
        prices := StyledText {
            format: TextFormat.html;
            selectable: true;
            font-size: 13px;
            text: "<h3>Prices</h3><table><tr><th>Item</th><th>Price</th></tr><tr><td>Tea</td><td>2 &euro;</td></tr><tr><td>Cake</td><td>3 &amp; up</td></tr></table>";
        }
        Rectangle {}
    }
}
