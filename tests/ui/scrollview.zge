// Scroll views whose content grows, comes and shows, down and sideways:
// their scroll bars follow.
import { ScrollView, ListView, TableView } from "std-widgets.zge";

export component Scrolls inherits Window {
    width: 300px;
    height: 100px;
    var in-out <int> rows: 2;
    var in-out <length> row-width: 50px;
    var in-out <bool> added;
    var in-out <bool> shown;

    // Content that grows: rows added to its layout.
    grows := ScrollView {
        x: 0px;
        width: 100px;
        height: 100px;
        VerticalLayout {
            for i in root.rows : Rectangle { height: 30px; width: root.row-width; }
        }
    }
    // Content that comes: a layout added by a condition.
    comes := ScrollView {
        x: 100px;
        width: 100px;
        height: 100px;
        if root.added : VerticalLayout {
            Rectangle { height: 300px; width: 250px; }
        }
    }
    // Content that shows: a hidden layout made visible.
    shows := ScrollView {
        x: 200px;
        width: 100px;
        height: 100px;
        VerticalLayout {
            visible: root.shown;
            Rectangle { height: 300px; width: 250px; }
        }
    }
}

// A list settling on its rows, and a table on its columns; to the top and
// the bottom, kept there as rows come.
export component Snaps inherits Window {
    width: 200px;
    height: 100px;
    var in-out <int> rows: 10;

    list := ListView {
        x: 0px;
        width: 100px;
        height: 100px;
        snap-to-items: true;
        for i in root.rows : Rectangle { height: 30px; }
    }
    table := TableView {
        x: 100px;
        width: 100px;
        height: 100px;
        snap-to-items: true;
        columns: ["a", "b", "c"];
        column-widths: [80px, 80px, 80px];
        for i in 3 : TableRow {
            Text { text: "a"; }
            Text { text: "b"; }
            Text { text: "c"; }
        }
    }
}
