// Scroll views whose content grows, comes and shows: their scroll bars
// follow.
import { ScrollView } from "std-widgets.zge";

export component Scrolls inherits Window {
    width: 300px;
    height: 100px;
    var in-out <int> rows: 2;
    var in-out <bool> added;
    var in-out <bool> shown;

    // Content that grows: rows added to its layout.
    grows := ScrollView {
        x: 0px;
        width: 100px;
        height: 100px;
        VerticalLayout {
            for i in root.rows : Rectangle { height: 30px; }
        }
    }
    // Content that comes: a layout added by a condition.
    comes := ScrollView {
        x: 100px;
        width: 100px;
        height: 100px;
        if root.added : VerticalLayout {
            Rectangle { height: 300px; }
        }
    }
    // Content that shows: a hidden layout made visible.
    shows := ScrollView {
        x: 200px;
        width: 100px;
        height: 100px;
        VerticalLayout {
            visible: root.shown;
            Rectangle { height: 300px; }
        }
    }
}
