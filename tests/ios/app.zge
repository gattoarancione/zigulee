// The iOS backend's test app (tests/ios/app.zig): a button, a text field,
// a table.
import { LineEdit, StandardTableView } from "std-widgets.zge";

export component IosTest inherits Window {
    width: 360px;
    height: 300px;
    background: #336699;
    var in-out <int> clicks;
    var in-out <string> typed <=> field.text;
    TouchArea {
        x: 0px;
        y: 0px;
        width: 120px;
        height: 60px;
        accessible-role: button;
        accessible-label: "Count";
        clicked => { root.clicks += 1; }
        accessible-action-default => { root.clicks += 1; }
    }
    field := LineEdit {
        x: 0px;
        y: 120px;
        width: 200px;
        height: 32px;
    }
    StandardTableView {
        x: 0px;
        y: 170px;
        width: 360px;
        height: 120px;
        columns: ["Name", "Born"];
        rows: [["Ada", "1815"], ["Grace", "1906"]];
    }
}
