{
  "name": "zigulee",
  "displayName": "zigulee",
  "description": "The .zge UI language of zigulee: highlighting, diagnostics, completion, go to definition, rename, formatting and a live preview",
  "version": "0.1.0",
  "publisher": "zigulee",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gattoarancione/zigulee"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "zge",
        "aliases": [
          "zigulee",
          "zge"
        ],
        "extensions": [
          ".zge"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zge",
        "scopeName": "source.zge",
        "path": "./syntaxes/zge.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "zigulee",
      "properties": {
        "zigulee.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the zigulee-lsp executable. Empty: the copy bundled by install.sh, then zig-out/bin/zigulee-lsp in an open folder, then zigulee-lsp on the PATH."
        },
        "zigulee.style": {
          "type": "string",
          "default": "fluent",
          "enum": [
            "fluent",
            "material",
            "minimal"
          ],
          "description": "Style of the standard widgets (std-widgets.zge): fluent, material or minimal."
        }
      }
    },
    "commands": [
      {
        "command": "zigulee.showPreview",
        "title": "Show Live Preview",
        "category": "zigulee",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "zigulee.showPreview",
          "when": "resourceLangId == zge",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "zigulee.showPreview",
          "when": "editorLangId == zge"
        }
      ]
    },
    "keybindings": [
      {
        "command": "zigulee.showPreview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == zge"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.0"
  },
  "scripts": {
    "package": "vsce package --out zigulee.vsix"
  }
}
